<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1145">

    <defaultcontrol always="true">6005</defaultcontrol>

    <controls>

        <!-- Close popup when pointer moves to upper screen area (not in OSD button strip). -->
        <control type="button" id="6090">
            <texturenofocus />
            <texturefocus />
            <font />
            <width>100%</width>
            <bottom>280</bottom>
            <onfocus>Close</onfocus>
        </control>

        <control type="group">
            <include>OSD_HideControls</include>

            <visible>!Window.IsActive(DialogPlayerProcessInfo.xml)</visible>
            <visible>!Window.IsVisible(DialogSlider.xml)</visible>

            <left>view_pad</left>
            <right>view_pad</right>

            <include content="OSD_CustomDialog_GroupList">
                <param name="onclick">$VAR[Action_OSD_WikiInfo]</param>
                <param name="icon">special://skin/extras/icons/info2.png</param>
                <param name="iconoffset_condition">false</param>
                <param name="button_5">true</param>
            </include>
        </control>

    </controls>
</window>
